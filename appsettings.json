{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "ComplianceCheck": "Debug"
    }
  },
  "AzureSearch": {
    "Url": "https://{searchEndpoint}.search.windows.net",
    "ApiKey": "{aiSearchKey}",
    "WebpageIndex": "{contentIndex}",
    "MultimodalIndex": "{criteriaIndex}"
  },
  "AzureOpenAI": {
    "Endpoint": "https://{aoaiEndpoint}.openai.azure.com",
    "DeploymentName": "{deploymentName}",
    "ApiKey": "{openApiKey}"
  },
  "ChatCompletion": {
    "TopP": 0.5,
    "Temperature": 0.0,
    "MaxOutputTokenCount": 16000,
    "MaxSearchQueries": 10000,
    "TopNDocuments": 50
  },
  "Retry": {
    "MaxRetries": 1,
    "DelayMs": 1000
  }
}
